<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything but the window: the connections (serial ports, USB HID devices, the demo signal), finding the
       devices, splitting what arrives into lines and plot values, and recording it. -->
  <PropertyGroup>
    <RootNamespace>AVASerMonitor.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Serial ports on Windows, Linux and macOS, USB-serial adapters included. -->
    <PackageReference Include="System.IO.Ports" Version="10.0.14" />
    <!-- USB HID devices, read directly: Windows, Linux (hidraw) and macOS (IOKit), in managed code. -->
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AVASerMonitor.Tests" />
  </ItemGroup>
</Project>
