<Project Sdk="Microsoft.NET.Sdk">
  <!-- The window: the device bar, the terminal, the plotter and the send box. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AVASerMonitor</AssemblyName>
    <RootNamespace>AVASerMonitor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/AVASerMonitor.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <ProjectReference Include="..\AVASerMonitor.Core\AVASerMonitor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AVASerMonitor.Tests" />
  </ItemGroup>
</Project>
